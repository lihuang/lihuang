.header .title { display: flex; align-items: baseline; }
.header .name { font-size: 36rpx; font-weight: 600; }
.header .code { margin-left: 16rpx; }
.header .price { font-size: 72rpx; font-weight: 700; margin-top: 12rpx; }
.header .change { font-size: 30rpx; margin-bottom: 8rpx; }
.cap-value { font-size: 48rpx; font-weight: 600; margin-top: 8rpx; }
.grid { display: flex; flex-wrap: wrap; }
.cell { width: 50%; padding: 12rpx 0; }
.chart { width: 100%; height: 360rpx; margin-top: 16rpx; }
.chart-axis { display: flex; justify-content: space-between; }
.actions { margin: 24rpx; }
